# ---------------------------------------------------------------------------
# AutoGenie configuration. Copy to .env and fill in:  cp .env.example .env
# ---------------------------------------------------------------------------

# Public domain (or free DuckDNS subdomain) pointing to this VPS.
# Telegram only delivers bot updates to HTTPS webhooks, Caddy handles TLS.
N8N_DOMAIN=leads.example.com

# Pin an n8n version for reproducible deploys (e.g. 2.4.0), or keep latest.
N8N_VERSION=latest

# Random secrets – generate with:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-long-random-string
SCRAPER_API_KEY=change-me-another-long-random-string

# Timezone for the schedule trigger (IANA name).
TZ=America/Chicago

# --- Telegram ---------------------------------------------------------------
# Comma-separated chat IDs allowed to use /leads (your user ID and/or group IDs).
# Get yours by messaging @userinfobot. Leave empty to allow everyone (not advised).
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Where scheduled runs are delivered: a user/group ID or a channel
# (@mychannel or -100xxxxxxxxxx). The bot must be an admin of the channel.
SCHEDULE_CHAT_ID=123456789

# Scheduled jobs, separated by ";".  Format per job:
#   niche | location | limit | flags(optional)
# Flags are the same as in Telegram: --no-website --has-website --phone
#   --min-rating 4 --min-reviews 10 --emails --all
SCHEDULED_JOBS=plumbers | Chicago, IL | 20 ; roofers | Austin, TX | 15 | --phone --emails

DEFAULT_LEAD_LIMIT=20

# --- Scraper ----------------------------------------------------------------
# Parallel browser tabs used to open place pages. 2-3 is gentle on a small VPS.
SCRAPER_CONCURRENCY=3
# Hard cap on leads per request.
SCRAPER_MAX_LIMIT=100
# Google Maps UI language (keep "en" – the parser expects English labels).
SCRAPER_LANG=en
# Optional outbound proxy for Chromium, e.g. socks5://127.0.0.1:1080 (leave empty).
SCRAPER_PROXY=
